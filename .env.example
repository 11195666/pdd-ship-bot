# 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES=

# 拼多多商家账号（Playwright 浏览器自动登录）
PDD_USERNAME=
PDD_PASSWORD=

# 发件人信息（必须，参考下方说明获取 addressId）
PDD_SENDER_NAME=
PDD_SENDER_MOBILE=
PDD_SENDER_PROVINCE=
PDD_SENDER_CITY=
PDD_SENDER_DISTRICT=
PDD_SENDER_ADDRESS=
PDD_SENDER_PROVINCE_ID=
PDD_SENDER_CITY_ID=
PDD_SENDER_DISTRICT_ID=
PDD_SENDER_ADDRESS_ID=

# 多地址支持（可选，JSON 数组）
# PDD_SENDERS=[{"addressId":2098579,"name":"张三","mobile":"13800000000","province":"山东省",...}]

# 短信验证码转发：
# 在 Android 手机上用任意短信转发工具（如 SMSForwarder），
# 将拼多多验证码 POST 到 http://服务器ip:3456/sms/receive
# Body 格式：{"content": "短信全文"}
# 无需在本文件中配置任何 SMS 相关参数
#
# 备选：连接已有短信中转服务的 Socket.IO 地址
# SMS_SOCKETIO_URL=http://localhost:5001

# 服务器端口
PORT=3456

# 可选：HTTP 代理地址（解决 VPS IP 被 PDD 风控拦截的问题）
# 支持 HTTP 和 SOCKS5 两种协议
#   HTTP:   PDD_HTTP_PROXY=http://localhost:3457
#   SOCKS5: PDD_HTTP_PROXY=socks5://localhost:3458
# PDD_HTTP_PROXY=

# ── 消息渠道配置 ──
# 当前支持企业微信 + LLM 口语化寄件。

# LLM 大模型口语化寄件（可选）
# 支持所有 OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / ollama 等）
# 开启后所有消息走 LLM，菜单命令完全屏蔽
LLM_ENABLE=true
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1          # 默认 OpenAI，其他服务商改这里
# LLM_SYSTEM_PROMPT=你是拼多多寄件助手...          # 自定义系统提示词，不设则用内置默认
# LLM_SYSTEM_PROMPT_FILE=/path/to/prompt.txt       # 或从文件读取提示词
